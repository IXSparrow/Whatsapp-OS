{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/lead-engine/extract",
      "destination": "/api/lead-engine/extract.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
