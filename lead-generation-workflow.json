{
  "name": "Lead Generation from Google Maps",
  "nodes": [
    {
      "parameters": {},
      "id": "2634c25d-ad0d-4b83-b88a-acc8c05142da",
      "name": "Start Lead Generation",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "businessType",
              "value": "<__PLACEHOLDER_VALUE__Business type (e.g., \"dentists\", \"roofing companies\")__>",
              "type": "string"
            },
            {
              "id": "2",
              "name": "location",
              "value": "<__PLACEHOLDER_VALUE__Location (e.g., \"New York, NY\")__>",
              "type": "string"
            },
            {
              "id": "3",
              "name": "maxResults",
              "value": null,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "06fc0524-e11d-4dbd-b259-29ca92e557d2",
      "name": "Set Input Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "queries",
              "value": "={{ [\n  $json.businessType + \" in \" + $json.location,\n  \"best \" + $json.businessType + \" near \" + $json.location,\n  $json.businessType + \" services \" + $json.location,\n  \"top rated \" + $json.businessType + \" \" + $json.location,\n  $json.businessType + \" companies in \" + $json.location,\n  $json.businessType + \" providers \" + $json.location,\n  \"local \" + $json.businessType + \" \" + $json.location,\n  \"affordable \" + $json.businessType + \" \" + $json.location,\n  \"highly rated \" + $json.businessType + \" near \" + $json.location,\n  $json.businessType + \" open now \" + $json.location,\n  $json.businessType + \" with reviews \" + $json.location,\n  $json.businessType + \" nearby \" + $json.location\n].sort(() => Math.random() - 0.5).slice(0, Math.max(3, Math.min(6, Math.ceil(($json.maxResults || 60) / 10)))) }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "8601c0fc-ae95-4097-a9d6-72f442e098de",
      "name": "Generate Search Queries",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        688,
        400
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "queries",
        "include": "allOtherFields",
        "options": {}
      },
      "id": "548870cb-8795-4372-9b24-7ef702eaf0d9",
      "name": "Split Queries",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        912,
        400
      ]
    },
    {
      "parameters": {
        "url": "https://serpapi.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "engine",
              "value": "google_maps"
            },
            {
              "name": "q",
              "value": "={{ $json.queries }}"
            },
            {
              "name": "type",
              "value": "search"
            },
            {
              "name": "num",
              "value": "={{ Math.max(1, Math.min(Math.floor(($json.maxResults || 60) / 3), 20)) }}"
            },
            {
              "name": "start",
              "value": "={{ [0, 20, 40][Math.floor(Math.random() * 3)] }}"
            },
            {
              "name": "no_cache",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "5d4d3969-1f4d-486d-9c77-972c2cedca18",
      "name": "Search Google Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1136,
        400
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "agcPgrhvpkZCoyrV",
          "name": "Query Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const businesses = [];\n\nfor (const item of $input.all()) {\n  const results = item.json.local_results || [];\n  \n  for (const business of results) {\n    // Extract operating hours as a formatted string\n    let openingHours = '';\n    if (business.operating_hours) {\n      openingHours = Object.entries(business.operating_hours)\n        .map(([day, hours]) => `${day.charAt(0).toUpperCase() + day.slice(1)}: ${hours}`)\n        .join('; ');\n    } else if (business.hours) {\n      openingHours = business.hours;\n    }\n    \n    // Extract address components\n    const addressParts = (business.address || '').split(',').map(s => s.trim());\n    const city = addressParts.length > 1 ? addressParts[addressParts.length - 2] : '';\n    const stateZip = addressParts.length > 0 ? addressParts[addressParts.length - 1] : '';\n    const stateParts = stateZip.split(' ');\n    const state = stateParts[0] || '';\n    const postalCode = stateParts.slice(1).join(' ') || '';\n    \n    businesses.push({\n      businessName: business.title || '',\n      category: business.type || '',\n      description: business.description || '',\n      address: business.address || '',\n      city: city,\n      state: state,\n      postalCode: postalCode,\n      country: 'US',\n      latitude: business.gps_coordinates?.latitude || '',\n      longitude: business.gps_coordinates?.longitude || '',\n      phone: business.phone || '',\n      email: '',\n      website: business.website || '',\n      googleMapsUrl: business.place_id_search ? `https://www.google.com/maps/place/?q=place_id:${business.place_id}` : '',\n      rating: business.rating || '',\n      reviewCount: business.reviews || 0,\n      priceRange: business.price || '',\n      openingHours: openingHours,\n      socialLinks: '',\n      placeId: business.place_id || '',\n      dataId: business.data_id || ''\n    });\n  }\n}\n\nreturn businesses.map(b => ({ json: b }));"
      },
      "id": "7716c3e2-2466-42fd-bc53-8ee07f213704",
      "name": "Extract Business Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
